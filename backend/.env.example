# Campus Byte Backend Environment Variables
PROJECT_NAME="Campus Byte API"
API_VERSION="v1"
DEBUG=false

# Database Configuration (PostgreSQL with psycopg driver)
# Inside Docker Compose:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/campus_byte
# For local host development:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campus_byte

# JWT Security
JWT_SECRET_KEY=dev_super_secret_jwt_key_campus_byte_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
