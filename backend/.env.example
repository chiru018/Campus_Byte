# Campus Byte Backend Environment Variables

# Application Settings
PROJECT_NAME="Campus Byte API"
API_VERSION="v1"
DEBUG=True

# Database Configuration (PostgreSQL with psycopg v3 driver)
# Replace 'username', 'password', 'localhost', '5432', and 'campus_byte' with your configuration
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/campus_byte

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

