# ==========================================
# Campus Byte - Environment Variables Example
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.
# ==========================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=campus_byte
POSTGRES_PORT=5432

# --- Backend Connection String (Local development — uses localhost) ---
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password_here@localhost:5432/campus_byte

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-secret-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Backend Service Settings ---
PROJECT_NAME="Campus Byte API"
API_VERSION="v1"
DEBUG=false

# --- CORS (comma-separated JSON array) ---
BACKEND_CORS_ORIGINS='["http://localhost","http://localhost:80","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'

# --- Frontend (Vite) ---
# Used during local `npm run dev` — in Docker, the nginx proxy handles /api routing
VITE_API_BASE_URL=http://localhost:8000
