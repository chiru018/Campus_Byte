# ============================================================
# Campus Byte — Environment Variables Configuration Template
# Copy this file to `.env` for local Docker / Host execution.
# DO NOT commit real secrets or `.env` to version control.
# ============================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campus_byte
POSTGRES_PORT=5432

# --- Backend Database URL ---
# Inside Docker Compose (service networking uses 'db' or 'postgres'):
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/campus_byte
# For local host development without Docker:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campus_byte

# --- JWT Authentication & Security ---
JWT_SECRET_KEY=dev_super_secret_jwt_key_campus_byte_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Cookie Security ---
AUTH_COOKIE_NAME=campus_byte_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true

# --- Backend Service Settings ---
PROJECT_NAME="Campus Byte API"
API_VERSION="v1"
DEBUG=false

# --- CORS Allowed Origins (JSON array string) ---
BACKEND_CORS_ORIGINS='["http://localhost","http://localhost:80","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]'

# --- Frontend Settings ---
# Used during local `npm run dev` — in Docker, nginx proxies /api to backend:8000
VITE_API_BASE_URL=http://localhost:8000
