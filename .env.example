# ==========================================
# Campus Byte - Global Environment Variables
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=campus_byte
POSTGRES_PORT=5432

# Backend Connection String (Local development)
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Backend Service Settings
PROJECT_NAME="Campus Byte API"
API_VERSION="v1"
DEBUG=True

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

